# ──────────────────────────────────────────────────────────────────────────────
# ~/Projects/idp/.env.example
#
# Copy to .env and fill in real values before running docker compose up.
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── Keycloak admin account ────────────────────────────────────────────────────
# These credentials log you in to the Keycloak admin console at
# http://localhost:8080/admin. They are NOT the seed test-user passwords
# defined in realm-config/idp-dev.json.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ── Keycloak backing database (Postgres) ──────────────────────────────────────
# This Postgres instance is ONLY for Keycloak's own metadata and session data.
# It is completely separate from the IDM app database and any future
# financial-system database — different container, different volume.
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=CHANGE_ME_db_password

# ── DMS federation ────────────────────────────────────────────────────────────
# This must match DMS_INTERNAL_IDP_API_KEY in ~/Projects/IDM/.env.
DMS_INTERNAL_IDP_API_KEY=CHANGE_ME_shared_dms_idp_key

# Keycloak reaches the DMS backend over the shared Docker idp-network.
DMS_INTERNAL_API_BASE_URL=http://backend:8000/api/v1/internal/idp
